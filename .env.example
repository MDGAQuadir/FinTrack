# ==============================================================================
# FinTrack Environment Variables Template (.env.example)
# Copy this file to .env or configure in your deployment dashboard (e.g. Render).
# DO NOT commit real secrets or credentials to GitHub!
# ==============================================================================

# Server & Mode Configuration
PORT=8080
DEVELOPMENT_MODE=false
SUPPORT_EMAIL=support@fintrack.app

# PostgreSQL 16 Database Configuration
POSTGRES_URL=jdbc:postgresql://localhost:5432/fintrack
POSTGRES_USER=fintrack_user
POSTGRES_PASSWORD=your_secure_postgres_password_here

# JWT Secret (Generate a strong random 256-bit key in production)
JWT_SECRET=your-super-secure-production-jwt-secret-key-2026-min-32-chars

# Live SMTP Configuration (For real OTP and PDF Statement email delivery)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-google-app-password

# Payment Gateway Webhook Secrets
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret_here
GENERIC_WEBHOOK_SECRET=your_custom_webhook_secret_token_here
